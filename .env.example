# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/lyrics_studio

# Port the HTTP server listens on. Defaults to 3000 if unset.
PORT=3000

# Comma-separated list of origins allowed to make cross-origin requests (browser CORS only —
# server-to-server/no-origin requests are always allowed). Leave unset/empty to block all
# cross-origin browser requests.
# ALLOWED_ORIGINS=https://example.com,https://app.example.com
